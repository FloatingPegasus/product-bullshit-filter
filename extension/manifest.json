{
  "manifest_version": 3,
  "name": "Product Bullshit Filter",
  "version": "1.0.0",
  "description": "Separates marketplace specs from marketing, checks seller terms, and flags suspicious review patterns.",
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Filter this product",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_page": "options/index.html"
}
